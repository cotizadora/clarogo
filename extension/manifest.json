{
  "manifest_version": 3,
  "name": "ClaroGo! Genesys",
  "short_name": "ClaroGo!",
  "version": "1.23.1",
  "description": "Lee los datos del cliente en la llamada de Genesys y los copia o los envía a Mi Planilla de ClaroGo!. Herramienta no oficial.",
  "action": {
    "default_title": "ClaroGo!: tomar datos de Genesys (Alt+Shift+G)",
    "default_popup": "popup.html",
    "default_icon": { "16": "icono-16.png", "32": "icono-32.png", "48": "icono-48.png", "128": "icono-128.png" }
  },
  "icons": { "16": "icono-16.png", "32": "icono-32.png", "48": "icono-48.png", "128": "icono-128.png" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+G" }, "description": "Abrir ClaroGo! y leer los datos de Genesys" }
  },
  "background": { "service_worker": "fondo.js" },
  "content_scripts": [
    { "matches": ["https://cotizadora.github.io/clarogo/*"], "js": ["puente.js"], "run_at": "document_start" },
    { "matches": ["https://*.clarochile.cl/*", "https://*.entel.cl/*", "https://*.movistar.cl/*", "https://*.wom.cl/*", "https://wom.cl/*"], "js": ["deuda.js"], "run_at": "document_idle" },
    { "matches": ["https://docs.google.com/forms/d/e/1FAIpQLSeWwyqN1vbUn3wOvHTImDsNFbUwVvG0rijrWWggigDqOrgJHQ/*", "https://docs.google.com/forms/d/e/1FAIpQLSe3nbhazUn9YVJqTLlP6tOdMZum-VkfEa9wTE8yAGPTqVuRsw/*"], "js": ["formas.js"], "run_at": "document_idle", "all_frames": true }
  ],
  "permissions": ["activeTab", "scripting", "clipboardWrite", "storage", "notifications"],
  "host_permissions": [
    "https://*.pure.cloud/*",
    "https://*.mypurecloud.com/*",
    "https://*.genesys.cloud/*",
    "https://cotizadora.github.io/*",
    "https://web.whatsapp.com/*",
    "https://docs.google.com/forms/*"
  ]
}
